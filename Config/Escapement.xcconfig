// Single place for product identity (SPEC §14). Renaming the product = editing this file.
PRODUCT_NAME = Rubis Music
PRODUCT_BUNDLE_IDENTIFIER = com.dikairos.escapement
MARKETING_VERSION = 0.8.7
CURRENT_PROJECT_VERSION = 24
DEVELOPMENT_TEAM = TA24A89R8H

MACOSX_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

ENABLE_HARDENED_RUNTIME = YES
// App has no AppIntents; skip metadata extraction to keep the build warning-free.
LM_SKIP_METADATA_EXTRACTION = YES
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = App/Escapement.entitlements
// Developer ID: the build is distributed outside the App Store and notarized,
// so Gatekeeper opens it on any Mac without the right-click dance. Replaces
// the self-signed "Rubis Dev 2" used until 0.8.4.
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGN_STYLE = Manual
// Secure timestamp is mandatory for notarization.
OTHER_CODE_SIGN_FLAGS = --timestamp
