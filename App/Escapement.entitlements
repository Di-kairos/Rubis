<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox intentionally off (SPEC §13): arbitrary disk access incl. external SSD.
	     Hardened runtime is enabled via ENABLE_HARDENED_RUNTIME in Config/Escapement.xcconfig. -->

	<!-- Library validation stays ON: the post-build script re-signs every embedded
	     framework with the app's own Developer ID, so all Team IDs match and dyld
	     is satisfied. The opt-out this file used to carry was only needed while the
	     app was signed ad-hoc (no Team ID at all). -->
</dict>
</plist>
