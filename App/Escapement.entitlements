<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox intentionally off (SPEC §13): arbitrary disk access incl. external SSD.
	     Hardened runtime is enabled via ENABLE_HARDENED_RUNTIME in Config/Escapement.xcconfig. -->

	<!-- Hardened runtime turns on library validation, which demands that every
	     embedded framework carry the same Team ID as the app. Ad-hoc signing has
	     no Team ID at all, so dyld refuses the decoder frameworks that SPM brings
	     in ("different Team IDs") and the app dies at launch. Local development
	     signing (SPEC §14) leaves no other option than opting out of validation. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
